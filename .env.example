# !! Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_long_random_string_here
BOT_TOKEN=your_telegram_bot_token
WEBAPP_URL=https://your-domain.com/webapp
ENVIRONMENT=production

# PostgreSQL — generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=generate_strong_password_here
DATABASE_URL=postgresql://aml:${POSTGRES_PASSWORD}@postgres:5432/aml
REDIS_URL=redis://redis:6379/0

# Start with 1 deposit address (legacy PAYMENT_ADDRESS_* works as pool of 1)
PAYMENT_ADDRESS_TRON=TYourTronDepositAddress
PAYMENT_ADDRESS_ETH=0xYourEthDepositAddress
PAYMENT_ADDRESS_BSC=0xYourBscDepositAddress
PAYMENT_ADDRESS_SOL=YourSolanaDepositAddress

# Or list: first DEPOSIT_POOL_SIZE = active, rest = standby for quarantine refill
DEPOSIT_POOL_TRON=
DEPOSIT_POOL_ETH=
DEPOSIT_POOL_BSC=
DEPOSIT_POOL_SOL=
DEPOSIT_POOL_SIZE=1

# Clean treasury — sweep only after daily screen marks address sweep_ready
TREASURY_ADDRESS_TRON=TYourCleanTreasuryTron
TREASURY_ADDRESS_ETH=0xYourCleanTreasuryEth
TREASURY_ADDRESS_BSC=0xYourCleanTreasuryBsc
TREASURY_ADDRESS_SOL=YourCleanTreasurySol
TREASURY_SCREEN_INTERVAL_SECONDS=86400

# Blockchain API keys & RPC endpoints (recommended for production rate limits)
TRONGRID_API_KEY=
TONAPI_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# SBP (Система быстрых платежей / RUB) — опционально
SBP_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Wave B — address monitoring
MONITOR_RECHECK_INTERVAL_SECONDS=21600
MONITOR_MAX_PER_USER=20

# Later: auto-create new deposit addresses from HD mnemonic when standby empty
# DEPOSIT_AUTO_GENERATE=true
# DEPOSIT_HD_MNEMONIC="word1 word2 ... word12"   # store in secrets, never commit
# DEPOSIT_HD_INDEX_TRON=0
# DEPOSIT_HD_INDEX_ETH=0

PRICE_PER_CHECK=1.0
SIGNUP_BONUS=1.0
FREE_CHECKS_PER_DAY=1

# OTC subscription plan
OTC_SUB_DAYS=30
OTC_SUB_CHECKS_PER_MONTH=100
OTC_SUB_PRICE=49.0

SENTRY_DSN=
# SECURITY: Must be false in production
ALLOW_DEV_TELEGRAM_AUTH=false
# Dev only — your Telegram ID for local testing
# DEV_TELEGRAM_ID=123456789
